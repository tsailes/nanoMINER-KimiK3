KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
# For a Kimi Code Console key, use these two values instead:
# KIMI_BASE_URL=https://api.kimi.com/coding/v1
# KIMI_MODEL=k3
# Global Open Platform accounts can instead use:
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high
KIMI_MAX_COMPLETION_TOKENS=32768
KIMI_MAX_AGENT_TURNS=10
KIMI_MAX_TOOL_RESULT_CHARS=180000
KIMI_REQUEST_TIMEOUT_SECONDS=300
KIMI_TRANSPORT_RETRIES=4
